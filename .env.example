# Chowk environment variables. NAMES ONLY — never commit real values. Documented in docs/environment.md.
# FREE RESOURCES ONLY: do not add a payment method to any provider account. See docs/free-tier.md.
# NEXT_PUBLIC_* is shipped to every browser: never put a secret there.

# ───────────── Shared ─────────────
APP_ENV=local                         # local | test | staging | production
LOG_LEVEL=info

# ───────────── Database (Neon Free) ─────────────
# RUNTIME (Workers / Next.js server): restricted role `chowk_app`, Neon POOLED host (contains "-pooler").
DATABASE_URL=
DB_POOL_MAX=5
# MIGRATIONS ONLY (owner role, DIRECT host). Lives in a developer shell / CI migration job.
# NEVER set this on Cloudflare, Render, or any deployed runtime.
DATABASE_URL_UNPOOLED=
# Password for the chowk_app login role; used only by packages/db/scripts/bootstrap-app-role.sh
CHOWK_APP_PASSWORD=

# ───────────── Web app (Cloudflare Workers via OpenNext) ─────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_REALTIME_URL=ws://localhost:2567
NEXT_PUBLIC_DEFAULT_LOCALE=en         # en | ur
NEXT_PUBLIC_PILOT_CENTER_LAT=         # set from reviewed config (docs/open-questions.md OQ-2)
NEXT_PUBLIC_PILOT_CENTER_LNG=
NEXT_PUBLIC_PILOT_ZOOM=15

# ───────────── Authentication (self-hosted Better Auth) ─────────────
BETTER_AUTH_SECRET=                   # SECRET, >= 32 random bytes (openssl rand -base64 48)
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=                     # Google OAuth (free); consent screen setup required
GOOGLE_CLIENT_SECRET=                 # SECRET
GUEST_MODE_ENABLED=true
# Magic link needs an email SENDER. Leave EMAIL_PROVIDER=console in dev (link printed to server log).
# `resend` = free tier (100/day, 3000/month) but likely requires a verified domain you already own. See docs/free-tier.md §2.
MAGIC_LINK_ENABLED=false
EMAIL_PROVIDER=console                # console | resend
RESEND_API_KEY=                       # SECRET (only if EMAIL_PROVIDER=resend)
EMAIL_FROM=                           # address on a verified domain

# ───────────── Realtime join tickets (asymmetric) ─────────────
REALTIME_TICKET_PRIVATE_KEY=          # SECRET, Ed25519 (PKCS8, base64). WEB APP ONLY.
REALTIME_TICKET_PUBLIC_KEY=           # public; given to the realtime server
REALTIME_TICKET_ISSUER=chowk-web

# ───────────── Realtime server (Colyseus on Render free web service) ─────────────
# NOTE: the realtime server gets NO database variables. It must never be configured with DATABASE_URL*.
REALTIME_PORT=2567
REALTIME_ALLOWED_ORIGINS=http://localhost:3000   # comma-separated allow-list, no wildcards in production
REALTIME_MAX_PLAYERS=40
VERIFY_COARSE_CELL_METERS=150

# ───────────── Storage (StorageAdapter) ─────────────
STORAGE_PROVIDER=local-fs             # local-fs (dev only) | neon-s3 | cloudinary  (chosen by the M-Storage spike)
STORAGE_LOCAL_ROOT=./.data/uploads
STORAGE_SIGNING_SECRET=               # SECRET, >= 32 chars (local-fs signed URLs)
UPLOAD_MAX_BYTES=5242880
# neon-s3 (if the spike confirms credentials can be issued to apps on the Free plan)
NEON_S3_ENDPOINT=
NEON_S3_REGION=
NEON_S3_BUCKET=
NEON_S3_ACCESS_KEY_ID=                # SECRET
NEON_S3_SECRET_ACCESS_KEY=            # SECRET
# cloudinary (fallback; Free = 25 credits/month pool)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=                # SECRET

# ───────────── Map tiles (MapLibre) ─────────────
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty   # OpenFreeMap, no key (verify usage terms before launch)

# ───────────── Quests & QR ─────────────
QR_SIGNING_SECRET=                    # SECRET, >= 32 bytes; signs single-use QR tokens
ALLOW_PLAYTEST_CONTENT=false          # MUST be false in production (placeholder content stays hidden)

# ───────────── Scheduled maintenance ─────────────
MAINTENANCE_SECRET=                   # SECRET; header for POST /api/internal/maintenance (called by a free scheduler)

# ───────────── Test / CI ─────────────
TEST_OWNER_URL=                       # superuser/owner URL for a THROWAWAY test database only
PLAYWRIGHT_BASE_URL=http://localhost:3000
E2E_FAKE_GEOLOCATION=true
