# Chowk environment variables. NAMES ONLY — never commit real values.
# Copy to .env.local (web) / .env (realtime). Documented in docs/environment.md.
# Rule: anything prefixed NEXT_PUBLIC_ is shipped to every browser. Never put secrets there.

# ───────────── Shared ─────────────
APP_ENV=local                       # local | staging | production
LOG_LEVEL=info                      # debug | info | warn | error

# ───────────── Supabase (public — safe for the browser) ─────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ───────────── Supabase (SECRET — realtime server & jobs ONLY, never apps/web) ─────────────
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_ISSUER=                # e.g. https://<project>.supabase.co/auth/v1
SUPABASE_JWKS_URL=                  # e.g. https://<project>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated

# ───────────── Web app ─────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_REALTIME_URL=ws://localhost:2567
NEXT_PUBLIC_DEFAULT_LOCALE=en       # en | ur
NEXT_PUBLIC_PILOT_CENTER_LAT=       # pilot map centre (set from reviewed config, see docs/open-questions.md OQ-2)
NEXT_PUBLIC_PILOT_CENTER_LNG=
NEXT_PUBLIC_PILOT_ZOOM=15

# ───────────── Map tiles (MapLibre) — provider TBD, OQ-7 ─────────────
NEXT_PUBLIC_MAP_STYLE_URL=          # style.json URL of the chosen vector tile provider
MAP_TILES_API_KEY=                  # SECRET if the provider needs one; proxy via route handler, don't expose

# ───────────── Bot protection (guest sign-in) ─────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=               # SECRET (web server only)

# ───────────── Realtime (Colyseus) ─────────────
REALTIME_PORT=2567
REALTIME_ALLOWED_ORIGINS=http://localhost:3000   # comma-separated allow-list, no wildcards in prod
REALTIME_MAX_ROOMS=200
REDIS_URL=                          # optional; only when running >1 realtime process (M8)

# ───────────── Verification tuning (server-side only) ─────────────
VERIFY_MAX_SPEED_MPS=12
VERIFY_COARSE_CELL_METERS=150
SITE_CODE_PEPPER=                   # SECRET; mixed into site-code hashes

# ───────────── Content gating ─────────────
# Mirrors private.app_flags.allow_playtest_content. MUST be false in production.
ALLOW_PLAYTEST_CONTENT=false

# ───────────── Observability (optional) ─────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ───────────── Test / CI ─────────────
PLAYWRIGHT_BASE_URL=http://localhost:3000
E2E_FAKE_GEOLOCATION=true           # Playwright uses context.setGeolocation; never real devices in CI
